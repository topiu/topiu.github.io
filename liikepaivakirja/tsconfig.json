{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": true,

    /* Deliberately loose for Phase 1. The port is behaviour-preserving, so the
       4000 lines of UI arrive untyped; domain/ and storage/ are typed and
       tested. Tighten module by module afterwards — turning strict on now would
       mean editing every line we just proved was moved verbatim. */
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["src", "tests"]
}
